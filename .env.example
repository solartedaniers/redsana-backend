# Cadena de conexion de SQLAlchemy a la base de datos propia (Postgres)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/redsana

# URL base del proyecto de Supabase (se usa para construir la URL del JWKS)
SUPABASE_URL=https://your-project.supabase.co

# Audience esperado en el JWT de Supabase (por defecto "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated

# Segundos que se cachea el JWKS en memoria antes de refrescarlo
JWKS_CACHE_TTL_SECONDS=3600

# Con un kid que no esta en el JWKS, segundos minimos entre refrescos (rotacion de claves sin dejar que un token
# inventado consulte a Supabase en cada peticion)
JWKS_UNKNOWN_KID_REFRESH_SECONDS=60

# Segundos maximos de espera por cada llamada HTTP a Supabase (JWKS y Admin API)
SUPABASE_HTTP_TIMEOUT_SECONDS=10

# Origenes permitidos por CORS, separados por coma. En produccion incluye el
# dominio web desplegado y los origenes de la app de escritorio instalada
# (Tauri usa http://tauri.localhost en Windows y tauri://localhost en macOS/Linux):
# CORS_ORIGINS=https://redsana.vercel.app,http://tauri.localhost,tauri://localhost
CORS_ORIGINS=http://localhost:4200

# Horas hacia atras que cubre /api/network-metrics/history cuando no se piden from/to
NETWORK_METRICS_DEFAULT_HISTORY_HOURS=24

# Umbrales del estado de la red (opcionales; estos son los valores por defecto). Una medicion es
# "advertencia" desde el umbral de advertencia de latencia (ms) o de perdida de paquetes (%), y "critica"
# desde el critico. El frontend los lee de GET /api/network-metrics/thresholds. Solo afectan a las
# mediciones nuevas: el estado se guarda al registrar cada una y las viejas no se recalculan.
NETWORK_STATUS_LATENCY_WARNING_MS=80
NETWORK_STATUS_LATENCY_CRITICAL_MS=150
NETWORK_STATUS_PACKET_LOSS_WARNING_PERCENT=1
NETWORK_STATUS_PACKET_LOSS_CRITICAL_PERCENT=5
# Latencia de las mediciones de la web (fetch hasta el servidor, no ping a la red local), con su propia escala.
# La perdida de paquetes usa los mismos umbrales de arriba. GET /api/network-metrics/thresholds?source=web.
NETWORK_STATUS_WEB_LATENCY_WARNING_MS=400
NETWORK_STATUS_WEB_LATENCY_CRITICAL_MS=800

# Minutos durante los que no se repite un aviso de degradacion, aunque el anterior ya se haya marcado como visto.
PREDICTION_ALERT_COOLDOWN_MINUTES=60

# Hora original de las mediciones que el cliente guarda sin conexion y reenvia despues (recorded_at, opcional).
# Se rechaza (422) si es mas vieja que MEASUREMENT_MAX_AGE_HOURS o si esta en el futuro mas alla de
# MEASUREMENT_MAX_FUTURE_SECONDS (relojes desfasados). Una medicion que llega con mas de
# MEASUREMENT_LATE_AFTER_SECONDS de retraso registra cortes, pero no dispara avisos de degradacion.
# Si ademas llega sent_at (hora del cliente al enviar), recorded_at se corrige al reloj del servidor antes de validar.
# Dos mediciones de la misma fuente a menos de MEASUREMENT_REPLAY_TOLERANCE_SECONDS son un reenvio.
MEASUREMENT_MAX_AGE_HOURS=24
MEASUREMENT_MAX_FUTURE_SECONDS=300
MEASUREMENT_LATE_AFTER_SECONDS=180
MEASUREMENT_REPLAY_TOLERANCE_SECONDS=10

# Diagnostico router / proveedor (solo con la latencia al router que mide el escritorio desde 0.1.6). Desde
# NETWORK_GATEWAY_LATENCY_BAD_MS el problema es el WiFi o el router; con eso y al menos NETWORK_BUSY_DEVICE_MIN_COUNT
# dispositivos conectados se sugiere, como posibilidad, que uno esta usando mucha red.
NETWORK_GATEWAY_LATENCY_BAD_MS=100
NETWORK_BUSY_DEVICE_MIN_COUNT=8

# Puntaje de seguridad (opcionales; estos son los valores por defecto): desde donde es "bueno" y "regular",
# y cuanto pesa el cuestionario frente al analisis tecnico (deben sumar 100). El frontend los lee de
# GET /api/security-assessments/score-config.
SECURITY_SCORE_GOOD_MIN=80
SECURITY_SCORE_WARNING_MIN=50
SECURITY_SCORE_QUESTIONNAIRE_WEIGHT_PERCENT=30
SECURITY_SCORE_TECHNICAL_WEIGHT_PERCENT=70

# Service role key de Supabase (NO la anon key): permite invitar/eliminar usuarios
# reales via la Admin API, usado solo por el dominio de administracion
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# API key gratuita de Groq (console.groq.com), solo para el asistente de seguridad.
# Nunca se expone al frontend. Obligatoria con AI_MODE=local; con AI_MODE=remote la usa el servicio de IA.
GROQ_API_KEY=your-groq-api-key

# Modelo de Groq usado por el asistente de seguridad (llama-3.3-70b-versatile
# fue retirado del catalogo; este es el modelo instruct disponible equivalente)
GROQ_MODEL=openai/gpt-oss-120b

# Endpoint de chat completions de Groq (opcional; este es el valor por defecto)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Segundos maximos de espera por una respuesta de Groq antes de dar error
GROQ_TIMEOUT_SECONDS=30

# Creatividad del modelo (0 = mas literal); baja para que copie datos exactos sin variarlos
GROQ_TEMPERATURE=0.2

# Secreto del HMAC que convierte la huella de red del escritorio en el identificador
# de red guardado (la MAC del router nunca se guarda). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Debe ser el mismo en todo backend que use la misma base de datos (local y Render):
# si cambia, cada red vuelve a calibrar la deteccion de anomalias desde cero.
NETWORK_ID_SECRET=your-network-id-secret

# Habilita POST /api/alerts para insertar alertas de prueba. Solo en desarrollo; en producción déjalo en false.
ENABLE_TEST_ALERTS_ENDPOINT=false

# Solo para pruebas: carpeta de diccionarios i18n del repo del frontend, relativa a este backend.
# Sin ella se salta la prueba que verifica que cada clave de alerta tiene texto en el frontend.
# FRONTEND_I18N_DIR=../redsana-frontend/public/assets/i18n

# Donde corre la IA: local (paquete redsana_ai en este proceso, por defecto) o remote
# (servicio de IA desplegado aparte). Cambiarla es lo unico que hace falta para pasar de uno a otro.
AI_MODE=local

# Solo con AI_MODE=remote: URL base del servicio de IA y la clave compartida con el
# (la misma AI_SERVICE_API_KEY definida en el servicio).
AI_SERVICE_URL=
AI_SERVICE_API_KEY=

# Segundos maximos por llamada al servicio (chat, resumen, detectores); mayor que el timeout de Groq
AI_SERVICE_TIMEOUT_SECONDS=45
# Segundos maximos de una consulta suelta del estado del servicio; corto para no frenar al usuario
AI_SERVICE_STATUS_TIMEOUT_SECONDS=5
# Segundos que /api/ai/status reutiliza el ultimo estado conocido sin consultar al servicio
AI_SERVICE_STATUS_CACHE_SECONDS=5
# Plazo total (segundos) para que Render despierte el servicio; vencido, la IA queda "no disponible".
# En produccion se usa 600: el arranque en frio de la IA llego a tardar ~6 min.
AI_SERVICE_WARM_UP_TIMEOUT_SECONDS=300
# Segundos que cada consulta del calentamiento deja abierta la peticion mientras Render despierta el servicio
AI_SERVICE_WARM_UP_PROBE_TIMEOUT_SECONDS=90
# Espera tras una consulta fallida (429/50x/sin conexion): empieza aqui y crece por el factor hasta el tope.
# Si Render envia Retry-After, se respeta.
AI_SERVICE_WARM_UP_BACKOFF_SECONDS=5
AI_SERVICE_WARM_UP_MAX_BACKOFF_SECONDS=15
AI_SERVICE_WARM_UP_BACKOFF_FACTOR=1.5
# Espera minima (segundos) si Render responde 429 con x-render-routing=hibernate-rate-limited
AI_SERVICE_WARM_UP_RATE_LIMITED_BACKOFF_SECONDS=30
# Retry-After (segundos) que el chat devuelve al frontend mientras la IA esta encendiendo
AI_SERVICE_WARM_UP_POLL_SECONDS=2
# Reintentos ante conexion rechazada o 502/503/504 del proxy, con espera creciente desde este valor
AI_SERVICE_MAX_RETRIES=2
AI_SERVICE_RETRY_BACKOFF_SECONDS=1
# Segundos tras el ultimo uso interactivo (calentamiento, chat o resumen) en que los detectores en
# segundo plano usan el servicio; fuera de esa ventana usan el paquete local para no despertarlo
AI_SERVICE_INTERACTIVE_WINDOW_SECONDS=600
